{
  "name": "skillbridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SkillBridge, Youth Skill Development and Internship Finder",
  "keywords": [
    "skillbridge",
    "youth skill development",
    "internship finder",
    "internships",
    "courses",
    "career skills"
  ],
  "scripts": {
    "predev": "node scripts/dev-startup.mjs",
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch-path=server server/index.js",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-skillbridge",
    "dev:emulator": "firebase emulators:exec --ui --only auth,firestore --project demo-skillbridge \"node scripts/run-emulator-command.mjs dev\"",
    "start": "npm run dev",
    "install:all": "npm install",
    "build": "vite build",
    "preview": "vite preview",
    "validate:data": "node scripts/validate-data.mjs",
    "build:demo-seed": "node scripts/build-demo-seed.mjs",
    "build:learning-paths": "node scripts/build-learning-paths.mjs",
    "test:search": "node scripts/test-search-filters.mjs",
    "build:search-tokens": "node scripts/build-search-tokens.mjs",
    "generate:companies": "node scripts/generate-company-seed.mjs",
    "check:links": "node scripts/check-links.mjs",
    "seed": "node scripts/seed.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-skillbridge \"node tests/firestore-rules.test.mjs\"",
    "test:e2e:emulator": "firebase emulators:exec --ui --only auth,firestore --project demo-skillbridge \"node scripts/run-emulator-command.mjs test:e2e\"",
    "seed:emulator": "firebase emulators:exec --only firestore --project demo-skillbridge \"node scripts/seed.mjs\"",
    "test:e2e": "playwright test",
    "check": "npm run validate:data && npm run test:search && npm run test:videos && npm run test:ai && npm run test:certificates && npm run build && npm run test:e2e && npm run test:rules",
    "check:videos": "node scripts/check-videos.mjs",
    "test:videos": "node --test tests/video-utils.test.mjs",
    "test:ai": "node --test tests/ai.test.mjs",
    "test:certificates": "node --test tests/certificate-utils.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.5.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.1",
    "firebase-tools": "^14.19.0",
    "vite": "^6.4.1"
  }
}
