# Optional port overrides for local development; defaults are in scripts/dev-config.mjs.
SKILLBRIDGE_WEB_PORT=3000
SKILLBRIDGE_API_PORT=3001
SKILLBRIDGE_TEST_WEB_PORT=4173

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_API_BASE_URL=

# Emulator mode uses safe demo Firebase config and never connects to production.
# `npm run dev:emulator` sets these values automatically.
# VITE_USE_AUTH_EMULATOR=true
# VITE_FIREBASE_API_KEY=demo-api-key
# VITE_FIREBASE_AUTH_DOMAIN=demo-skillbridge.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=demo-skillbridge
# VITE_FIREBASE_STORAGE_BUCKET=demo-skillbridge.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
# VITE_FIREBASE_APP_ID=1:1234567890:web:demo
# VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
VITE_FIRESTORE_EMULATOR_HOST=
VITE_FIREBASE_AUTH_EMULATOR_HOST=
